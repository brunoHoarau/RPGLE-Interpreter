{
  "name": "vscode-rpgle-interpreter",
  "displayName": "RPGLE Interpreter",
  "description": "Parse et exécute du RPGLE Free Form sans compilation",
  "version": "0.0.1",
  "publisher": "brunohoarau",
  "repository": {
    "type": "git",
    "url": "https://github.com/brunoHoarau/RPGLE-Interpreter.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:rpgle"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "rpgle.execute",
        "title": "RPGLE: Exécuter le code"
      },
      {
        "command": "rpgle.validate",
        "title": "RPGLE: Valider la syntaxe"
      }
    ],
    "languages": [
      {
        "id": "rpgle",
        "aliases": [
          "RPGLE",
          "rpgle"
        ],
        "extensions": [
          ".rpgle",
          ".RPGLE"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "resourceLangId == rpgle",
          "command": "rpgle.execute",
          "group": "navigation"
        },
        {
          "when": "resourceLangId == rpgle",
          "command": "rpgle.validate",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "rpgle.execute",
        "key": "ctrl+shift+r",
        "when": "editorTextFocus && resourceLangId == rpgle"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "node scripts/clean-out.js && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node --test \"test/**/*.test.js\"",
    "package": "npx --yes @vscode/vsce package --no-dependencies",
    "check-size": "node scripts/check-size.js",
    "check": "npm test && npm run check-size"
  },
  "devDependencies": {
    "@types/node": "^16.18.126",
    "@types/vscode": "^1.80.0",
    "typescript": "^4.9.5"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs"
}
